{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valleemapper",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "containers": [
    {
      // The existing Container application keeps its name when the Worker is renamed.
      "name": "mont-blanc-mobilite-motisrouter",
      "class_name": "MotisRouter",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile" } },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROUTER", "class_name": "MotisRouter" }],
  },
  "exports": {
    "MotisRouter": { "type": "durable-object", "storage": "sqlite" },
  },
  "observability": { "enabled": true, "redact_query_string": true },
}
