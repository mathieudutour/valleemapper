{
  "name": "valleemapper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "setup": "python3 scripts/prepare.py",
    "data:refresh": "python3 scripts/prepare.py --refresh",
    "build": "tsc --noEmit && tsc -p cloudflare/tsconfig.json && vite build",
    "check": "tsc --noEmit && tsc -p cloudflare/tsconfig.json",
    "smoke": "tsx scripts/smoke.ts",
    "reachability": "tsx scripts/reachability.ts",
    "cloudflare:check": "wrangler deploy --dry-run --containers-rollout=none",
    "format": "prettier --write src server scripts/*.ts cloudflare *.json *.jsonc *.ts *.html README.md",
    "test": "tsx --test scripts/*.test.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "maplibre-gl": "6.19.0",
    "lucide-react": "1.75.0"
  },
  "devDependencies": {
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "wrangler": "4.164.0",
    "@cloudflare/workers-types": "5.20261118.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/geojson": "7946.0.16",
    "prettier": "3.10.1"
  }
}
